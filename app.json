{
  "expo": {
    "name": "Earning Tracker",
    "slug": "earning-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/earning-tracker-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hussnainali.driverearnings",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/earning-tracker-icon.png",
      "name": "Earning Tracker",
      "shortName": "Earning Tracker"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-mail-composer",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "570cd07f-7792-4984-99f5-6b30b81c61ad"
      }
    }
  }
}
