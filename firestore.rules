rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    function amount(v) { return v is int && v >= 0 && v <= 99999999999; }
    match /users/{uid}/weekly_records/{week} {
      allow read, delete: if own(uid);
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['id','date','endDate','amounts','percentage','notes','updatedAt'])
        && request.resource.data.id == week && request.resource.data.date == week
        && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate >= request.resource.data.date
        && request.resource.data.amounts is list && request.resource.data.amounts.size() == 5
        && amount(request.resource.data.amounts[0]) && amount(request.resource.data.amounts[1])
        && amount(request.resource.data.amounts[2]) && amount(request.resource.data.amounts[3]) && amount(request.resource.data.amounts[4])
        && request.resource.data.percentage is number && request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/qasa_months/{month} {
      allow read, delete: if own(uid);
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['month','bolt','uber','uberRefund','totalUberCash','uberCashInHand','totalZettle','taxiTime','expense','percentage','notes','currency','uberCashInZettle','okeriSwishCard','totalQasa','share','schemaVersion','updatedAt'])
        && request.resource.data.month == month && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && amount(request.resource.data.bolt) && amount(request.resource.data.uber)
        && amount(request.resource.data.uberRefund) && amount(request.resource.data.totalUberCash)
        && amount(request.resource.data.uberCashInHand) && amount(request.resource.data.totalZettle)
        && amount(request.resource.data.taxiTime) && amount(request.resource.data.expense)
        && request.resource.data.percentage is number && request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.currency in ['SEK','EUR','USD','GBP']
        && request.resource.data.schemaVersion == 1 && request.resource.data.updatedAt == request.time
        && request.resource.data.uberCashInZettle == request.resource.data.totalUberCash - request.resource.data.uberCashInHand - request.resource.data.expense
        && request.resource.data.okeriSwishCard == request.resource.data.totalZettle - request.resource.data.uberCashInZettle
        && request.resource.data.totalQasa == request.resource.data.bolt + request.resource.data.uber + request.resource.data.uberRefund + request.resource.data.totalZettle + request.resource.data.taxiTime - request.resource.data.uberCashInZettle
        && request.resource.data.share is int
        && request.resource.data.share == math.floor(request.resource.data.totalQasa * request.resource.data.percentage / 100 + 0.5);
    }
    match /users/{uid}/qasa_weeks/{week} {
      allow read, delete: if own(uid);
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['date','endDate','bolt','uber','uberRefund','totalUberCash','uberCashInHand','totalZettle','taxiTime','expense','percentage','notes','currency','uberCashInZettle','okeriSwishCard','totalQasa','share','schemaVersion','updatedAt'])
        && request.resource.data.date == week
        && week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate >= request.resource.data.date
        && amount(request.resource.data.bolt) && amount(request.resource.data.uber)
        && amount(request.resource.data.uberRefund) && amount(request.resource.data.totalUberCash)
        && amount(request.resource.data.uberCashInHand) && amount(request.resource.data.totalZettle)
        && amount(request.resource.data.taxiTime) && amount(request.resource.data.expense)
        && request.resource.data.percentage is number && request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.currency in ['SEK','EUR','USD','GBP']
        && request.resource.data.schemaVersion == 1 && request.resource.data.updatedAt == request.time
        && request.resource.data.uberCashInZettle == request.resource.data.totalUberCash - request.resource.data.uberCashInHand - request.resource.data.expense
        && request.resource.data.okeriSwishCard == request.resource.data.totalZettle - request.resource.data.uberCashInZettle
        && request.resource.data.totalQasa == request.resource.data.bolt + request.resource.data.uber + request.resource.data.uberRefund + request.resource.data.totalZettle + request.resource.data.taxiTime - request.resource.data.uberCashInZettle
        && request.resource.data.share is int
        && request.resource.data.share == math.floor(request.resource.data.totalQasa * request.resource.data.percentage / 100 + 0.5);
    }
    match /users/{uid}/settings/profile {
      allow read: if own(uid);
      allow write: if own(uid) && request.resource.data.keys().hasOnly(['percentage','currency','ownerEmail','userName'])
        && request.resource.data.percentage is number && request.resource.data.percentage >= 0 && request.resource.data.percentage <= 100
        && request.resource.data.currency in ['SEK','EUR','USD','GBP']
        && (!request.resource.data.keys().hasAny(['ownerEmail']) || (request.resource.data.ownerEmail is string && request.resource.data.ownerEmail.size() <= 320))
        && (!request.resource.data.keys().hasAny(['userName']) || (request.resource.data.userName is string && request.resource.data.userName.size() <= 120));
    }
  }
}
